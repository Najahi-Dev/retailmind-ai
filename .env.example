# ==============================================================================
# RetailMind AI - Environment Variables Template
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Backend Configuration
# ------------------------------------------------------------------------------
# Generated automatically when running `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex client URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ------------------------------------------------------------------------------
# 2. Application & Authentication
# ------------------------------------------------------------------------------
# Base URL for the frontend application (update to production domain when deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key for JWT token generation and verification
# Generate a secure 64-character random string (e.g., `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# 3. Email & Notification Services
# ------------------------------------------------------------------------------
# Resend API Key (Optional / Primary email delivery)
RESEND_API_KEY=re_your_resend_api_key_here

# Brevo API Key (Optional / Fallback invoice delivery)
BREVO_API_KEY=your_brevo_api_key_here

# Gmail SMTP Configuration (For system credential and notification emails)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_specific_password

# ------------------------------------------------------------------------------
# 4. Stripe Payments & Subscriptions
# ------------------------------------------------------------------------------
# Stripe API Keys (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Stripe Price IDs (Dashboard -> Product Catalog)
STRIPE_STARTER_PRICE_ID=prod_starter_price_id_here
STRIPE_GROWTH_PRICE_ID=prod_growth_price_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_custom

# ------------------------------------------------------------------------------
# 5. AI & Microservices
# ------------------------------------------------------------------------------
# FastAPI / Python Forecasting service URL
AI_SERVICE_URL=http://localhost:8000