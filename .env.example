# ==============================================================================
# RetailMind AI - Environment Variables Template
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex Backend Configuration
# ------------------------------------------------------------------------------
# Generated automatically when running `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex client URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ------------------------------------------------------------------------------
# 2. Application & Authentication
# ------------------------------------------------------------------------------
# Base URL for the frontend application (update to production domain when deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HS256 secret for access JWTs. MUST be >= 32 characters and identical in the
# Next.js env AND the Convex deployment env (`npx convex env set JWT_SECRET ...`).
# Generate: `openssl rand -base64 48`
JWT_SECRET=replace_with_at_least_32_random_characters

# Shared secret proving Convex calls come from the trusted Next.js server
# (rate limiting, Stripe webhook mutations). >= 32 chars; set in BOTH Next.js
# and Convex envs. Generate: `openssl rand -hex 32`
AUTH_SERVER_SECRET=replace_with_openssl_rand_hex_32

# Bearer token required by /api/cron/* (Authorization: Bearer $CRON_SECRET).
# >= 32 chars. Generate: `openssl rand -hex 32`
CRON_SECRET=replace_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. Email & Notification Services
# ------------------------------------------------------------------------------
# Resend API Key (Optional / Primary email delivery)
RESEND_API_KEY=re_your_resend_api_key_here

# Brevo API Key (Optional / Fallback invoice delivery)
BREVO_API_KEY=your_brevo_api_key_here

# Gmail SMTP Configuration (For system credential and notification emails)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_specific_password

# ------------------------------------------------------------------------------
# 4. Stripe Payments & Subscriptions
# ------------------------------------------------------------------------------
# Stripe API Keys (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Stripe Price IDs (Dashboard -> Product Catalog)
# Must be Price IDs (price_...), not product IDs. The plan tier of a subscription
# is derived ONLY from these whitelisted price IDs.
STRIPE_STARTER_PRICE_ID=price_starter_id_here
STRIPE_GROWTH_PRICE_ID=price_growth_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_id_here

# ------------------------------------------------------------------------------
# 5. AI & Microservices
# ------------------------------------------------------------------------------
# FastAPI / Python Forecasting service URL
AI_SERVICE_URL=http://localhost:8000

# API key the AI service requires in the X-API-Key header (set on the AI service
# AND in the Convex env so convex/forecasting.ts can send it).
# Generate: `openssl rand -hex 32`
AI_SERVICE_API_KEY=replace_with_openssl_rand_hex_32

# (AI service) Comma-separated browser origins allowed by CORS. "*" is ignored.
ALLOWED_ORIGINS=http://localhost:3000
